# Snowflake key-pair auth — copy to .env and fill with YOUR values (.env is gitignored)
SNOWFLAKE_ACCOUNT=ORG-ACCOUNT            # account identifier, e.g. ABCD-XY12345 (hyphen form)
SNOWFLAKE_USER=your_user
SNOWFLAKE_PRIVATE_KEY_FILE=/home/youruser/.snowflake/keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_key_passphrase
SNOWFLAKE_ROLE=PROJECT2_ENGINEER
SNOWFLAKE_WAREHOUSE=WH_XS
SNOWFLAKE_DATABASE=NYC_TLC
SNOWFLAKE_SCHEMA=RAW
